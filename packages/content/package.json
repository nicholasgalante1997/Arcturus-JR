{
  "name": "@arcjr/content",
  "version": "1.0.0",
  "description": "Shared content contract (schemas, parse/serialize, load, manifest) for @ArcJr posts and RFCs",
  "private": true,
  "type": "module",
  "module": "./dist/index.js",
  "types": "./dist/src/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "run-s bundle check-types",
    "bundle": "bun run build.ts",
    "bundle:watch": "bun run build.ts --watch",
    "check-types": "tsc -p tsconfig.json && tsc-alias -p tsconfig.json",
    "clean": "rm -rf dist",
    "test": "bun test"
  },
  "peerDependencies": {
    "typescript": "latest"
  },
  "dependencies": {
    "front-matter": "^4.0.2",
    "js-yaml": "^4.1.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "latest",
    "@types/js-yaml": "^4.0.9",
    "npm-run-all": "4.1.5",
    "tsc-alias": "^1.8.16",
    "typescript": "^5.0.0"
  }
}
